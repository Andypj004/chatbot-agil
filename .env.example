# LLM API Keys (configure the ones you want to use)
OPENAI_API_KEY=sk-your_openai_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
GOOGLE_API_KEY=your_google_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
# Optional for Ollama (usually not needed)
OLLAMA_API_KEY=

# Application Settings
# NOTE: this branch (test/google-default-only) is locked to a single
# provider/model for a real-user pilot. LLMFactory ignores any
# provider/model requested by the frontend or API and always uses these.
DEFAULT_LLM_PROVIDER=google
DEFAULT_MODEL=gemini-3.1-flash-lite
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOG_LEVEL=INFO
MAX_TOKENS=2000
TEMPERATURE=0.7
OLLAMA_BASE_URL=http://localhost:11434

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
RAG_CONTEXT_MAX_CHARS=6000
WARMUP_VECTOR_STORE_ON_STARTUP=true
WARMUP_DEFAULT_PROVIDER_ON_STARTUP=false
